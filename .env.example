# ─────────────────────────────────────────────────────────────
# NEXUS environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is ignored by Git, so your keys stay on your machine.
# NEVER put a Supabase service-role key in this project.
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for SEO metadata, sitemap and auth email links).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (optional until you set it up — see SUPABASE_SETUP.md) ──
# Without these, NEXUS still works: content comes from local files and
# bookmarks / progress are saved in the browser.
# Find them in Supabase: Project Settings → API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (starts with sb_publishable_...). It is safe in the browser
# because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects: you can use the legacy "anon" key instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where topics, resources, paths and projects come from.
#   local    → the TypeScript files in /data (default)
#   supabase → the database tables (run supabase/seed.sql first)
NEXUS_CONTENT_SOURCE=local

# ── Tech Updates ──
# Live updates come from public RSS/Atom feeds (no API keys needed).
# Set to "true" to always show the clearly labelled sample data instead
# (useful when working offline).
NEXUS_DISABLE_FEEDS=false
